# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only, never expose to the browser. Needed for scripts/seed.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Site's own public URL. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# scripts/seed.ts — real email + password for each Artbridge account. Also
# used to reset a password on re-run (see the comment at the top of the script).
SEED_ADAM_EMAIL=
SEED_ADAM_PASSWORD=
SEED_ESZTER_EMAIL=
SEED_ESZTER_PASSWORD=
SEED_KURATOR_EMAIL=
SEED_KURATOR_PASSWORD=

# Gmail integration (Google Cloud Console → APIs & Services → Credentials).
# Redirect URI must be registered as <site-url>/api/gmail/callback for both
# production and http://localhost:3000.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional cron-route auth (see vercel.json + src/app/api/cron/gmail-sync).
CRON_SECRET=

ANTHROPIC_API_KEY=
