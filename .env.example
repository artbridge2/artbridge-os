# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only, never expose to the browser. Needed for scripts/seed.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the magic-link redirect URL. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# scripts/seed.ts — real email addresses for the 3 Artbridge accounts
SEED_ADAM_EMAIL=
SEED_ESZTER_EMAIL=
SEED_KURATOR_EMAIL=
